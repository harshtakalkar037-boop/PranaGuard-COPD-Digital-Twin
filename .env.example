# SYNTHETIC DEMONSTRATION ONLY. Never enter real patient information.
# Existing SQLite files are migrated additively. Do not use bootstrap --reset on your working DB.
PRANAGUARD_DB=data/pranaguard.sqlite
# Legacy flag describes the original historical replay, not the opt-in context service below.
PRANAGUARD_OFFLINE=true

# Empty token means UNAUTHENTICATED writes: local synthetic demo only.
# Configure a strong token and an explicit origin list before network exposure.
PRANAGUARD_ADMIN_TOKEN=
PRANAGUARD_CORS_ORIGINS=*
# Backend-only HMAC master for simulated-device ingestion; empty => ephemeral local tokens.
# Tokens never appear in API responses or browser code. Simulations stop on backend restart.
PRANAGUARD_DEVICE_SECRET=

# Browser uses same-origin /api by default. This target is consumed by the Vite server only.
API_PROXY_TARGET=http://127.0.0.1:8000
# Optional PUBLIC backend origin for separate hosting. Not an API key; omit for local/proxy use.
VITE_API_BASE_URL=

# Optional current modelled city context. OFF by default; no network needed for replay.
PRANAGUARD_LIVE_ENV_ENABLED=false
PRANAGUARD_ENV_TTL_SECONDS=900
# Minimum300 seconds per component (also on forced refresh); errors back off up to1 hour.
PRANAGUARD_ENV_RETRY_SECONDS=300
PRANAGUARD_ENV_TIMEOUT_SECONDS=8
# No key required for free NON-COMMERCIAL Open-Meteo access within their terms.
# A paid customer key switches to documented customer hosts; paid access is not externally tested.
OPEN_METEO_API_KEY=

# Explicit demo-only email test. No automatic patient/model-alert email is implemented.
# disabled: honest not-sent result. preview: local outbox only. smtp: explicit configured test.
PRANAGUARD_EMAIL_MODE=disabled
PRANAGUARD_SMTP_HOST=
PRANAGUARD_SMTP_PORT=587
PRANAGUARD_SMTP_USER=
PRANAGUARD_SMTP_PASSWORD=
PRANAGUARD_SMTP_FROM=
# Exactly one operator-configured demo recipient. No arbitrary frontend recipient overrides.
PRANAGUARD_DEMO_RECIPIENT=
PRANAGUARD_SMTP_STARTTLS=true
PRANAGUARD_SMTP_SSL=false
# Only for a deliberate localhost SMTP capture test; never enables cleartext external SMTP.
PRANAGUARD_SMTP_ALLOW_INSECURE_LOCAL=false

# Synthetic demo provisioning: disabled by default. Enable only on an isolated,
# access-controlled demo using a disposable synthetic-only database. Temporary
# patient credentials are predictable and must be changed at first sign-in.
PRANAGUARD_SYNTHETIC_DEMO_PROVISIONING=0
# PRANAGUARD_UPLOAD_DIR=/absolute/private/path/outside/the/web/root
